{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build local_search (debug)",
            "type": "shell",
            "command": "make",
            "args": ["debug"],
            "options": {
                "cwd": "${workspaceFolder}/local_search"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "build nested_example (debug)",
            "type": "shell",
            "command": "cmake -S \"${workspaceFolder}/math_formula/standalone_optimizer\" -B \"${workspaceFolder}/math_formula/standalone_optimizer/build/debug\" -DCMAKE_BUILD_TYPE=Debug -DCMAKE_EXPORT_COMPILE_COMMANDS=ON && cmake --build \"${workspaceFolder}/math_formula/standalone_optimizer/build/debug\" --target mmopt_nested_example",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": ["$gcc"]
        }
    ]
}
